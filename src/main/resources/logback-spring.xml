<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!-- Console output - human readable for development -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- JSON console output for Docker (parsed by logging infrastructure) -->
    <appender name="JSON_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <includeMdcKeyName>trace_id</includeMdcKeyName>
            <includeMdcKeyName>span_id</includeMdcKeyName>
            <includeMdcKeyName>user_id</includeMdcKeyName>
            <includeMdcKeyName>request_id</includeMdcKeyName>
            <customFields>{"application":"shapyfy-core","environment":"${SPRING_PROFILES_ACTIVE:-dev}"}</customFields>
        </encoder>
    </appender>

    <!-- Root logger - profile-specific configs below -->

    <!-- Dev/Local profile: human-readable console -->
    <springProfile name="dev,local">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <!-- Production/Staging profile: JSON console for log aggregation -->
    <springProfile name="production,staging">
        <root level="INFO">
            <appender-ref ref="JSON_CONSOLE"/>
        </root>
    </springProfile>

    <!-- Spring Boot specific loggers -->
    <logger name="org.springframework.web" level="INFO"/>
    <logger name="org.springframework.security" level="INFO"/>
    <logger name="org.springframework.boot" level="INFO"/>
    <logger name="org.flywaydb" level="INFO"/>

    <!-- Your application logger -->
    <logger name="com.shapyfy" level="DEBUG"/>

    <!-- SQL logging (useful for debugging) -->
    <logger name="org.springframework.jdbc.core" level="DEBUG"/>

    <!-- Reduce noise from some libraries -->
    <logger name="org.hibernate" level="WARN"/>
    <logger name="io.lettuce" level="WARN"/>
</configuration>
